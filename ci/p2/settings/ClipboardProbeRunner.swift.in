import Foundation
import CoreFoundation

// Public fixture-only measurement handshake. It cannot invoke a product action.
// App and runner uptimes are never treated as the same clock by the verifier.
@MainActor
final class SettingsClipboardProbeRunner {
    let nonce: String
    private var names: [String: Int] = [:]
    private var nextRequest = 1
    private var pending: Int?
    private(set) var acknowledgements: [[String: Any]] = []
    private(set) var requests: [[String: Any]] = []
    private(set) var failures: [String] = []

    init(nonce: String) {
        self.nonce = nonce
        guard UUID(uuidString: nonce) != nil else { failures.append("invalid-session"); return }
        let observer = Unmanaged.passUnretained(self).toOpaque()
        for id in 1...64 {
            let name = "p2.clipboard." + nonce + ".ack." + String(id)
            names[name] = id
            CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(), observer,
                { _, pointer, name, _, _ in
                    guard let pointer, let name else { return }
                    let value = Unmanaged<SettingsClipboardProbeRunner>.fromOpaque(pointer).takeUnretainedValue()
                    MainActor.assumeIsolated { value.receive(name.rawValue as String) }
                }, name as CFString, nil, .deliverImmediately)
        }
    }

    private func receive(_ name: String) {
        guard let id = names[name] else { failures.append("unknown-acknowledgement"); return }
        acknowledgements.append(["nonce": nonce, "requestSequence": id,
            "runnerUptime": ProcessInfo.processInfo.systemUptime,
            "runnerProcessIdentifier": ProcessInfo.processInfo.processIdentifier])
        if pending != id || acknowledgements.filter({ $0["requestSequence"] as? Int == id }).count != 1 {
            failures.append("stale-duplicate-or-out-of-order-acknowledgement")
        }
    }

    func sample(_ stage: String) throws -> [String: Any] {
        guard failures.isEmpty, pending == nil, nextRequest <= 64 else {
            throw NSError(domain: "P2ClipboardProbe", code: 1,
                userInfo: [NSLocalizedDescriptionKey: "Invalid serialized clipboard measurement state"])
        }
        let id = nextRequest
        nextRequest += 1
        pending = id
        let index = requests.count
        let started = ProcessInfo.processInfo.systemUptime
        requests.append(["nonce": nonce, "requestSequence": id, "stage": stage,
            "runnerProcessIdentifier": ProcessInfo.processInfo.processIdentifier,
            "requestUptime": started])
        let name = "p2.clipboard." + nonce + ".request." + String(id)
        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
            CFNotificationName(rawValue: name as CFString), nil, nil, false)
        while failures.isEmpty && !acknowledgements.contains(where: { $0["requestSequence"] as? Int == id })
                && ProcessInfo.processInfo.systemUptime - started < 5 {
            // Darwin callbacks need an active common-mode run loop. Do not use
            // Thread.sleep here and do not synthesize or retry a missing ack.
            _ = RunLoop.current.run(mode: .default, before: Date(timeIntervalSinceNow: 0.01))
        }
        let matching = acknowledgements.filter { $0["requestSequence"] as? Int == id }
        pending = nil
        guard failures.isEmpty, matching.count == 1, let ack = matching.first else {
            failures.append("missing-or-invalid-acknowledgement")
            throw NSError(domain: "P2ClipboardProbe", code: 2,
                userInfo: [NSLocalizedDescriptionKey: "App-process clipboard sample was not acknowledged"])
        }
        requests[index]["ackUptime"] = ack["runnerUptime"]
        requests[index]["returnUptime"] = ProcessInfo.processInfo.systemUptime
        return requests[index]
    }

    func stop() {
        CFNotificationCenterRemoveEveryObserver(CFNotificationCenterGetDarwinNotifyCenter(),
            Unmanaged.passUnretained(self).toOpaque())
    }
}
