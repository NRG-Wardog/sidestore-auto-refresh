import Foundation
import XCTest

// This code runs only in a separately generated XCTest runner. It imports no
// product module, never evaluates product source, and never creates a host app.
final class HostSettingsProbeTests: XCTestCase {
    private let identity: [String: String] = [
        "bundleIdentifier": __HOST_BUNDLE_ID__,
        "executableSHA256": __HOST_EXECUTABLE_SHA256__,
        "sourceCommit": __SOURCE_COMMIT__,
        "sourceTree": __SOURCE_TREE__,
        "builderCommit": __BUILDER_COMMIT__
    ]
    private var app: XCUIApplication!
    private var observations: [[String: Any]] = []
    private var navigation: [[String: Any]] = []
    private var serviceFailure: [String: Any]?
    private var status = "blocked"
    private var stage = "before-launch"
    private var launchCount = 0
    private var launchCallEntered = false
    private var launchCallReturned = false
    private var failureDiagnosticSequence = 0
    private var launchPolicy: [String: Any] = ["status": "not-reached"]
    // The generated target map and this external proxy getter are separate inputs.
    // Empty initial requested inputs were observed in authenticated run 39108204781.
    private let expectedInitialEnvironment: [String: String] = [:]
    private let generatedTargetEnvironment: [String: String] = __GENERATED_TARGET_ENVIRONMENT__

    override func setUpWithError() throws {
        continueAfterFailure = false
    }

    private func attachText(_ text: String, name: String) {
        let attachment = XCTAttachment(string: text)
        attachment.name = name
        attachment.lifetime = .keepAlways
        add(attachment)
    }

    private func publishLaunchPolicy() -> Bool {
        let record: [String: Any] = ["schemaVersion": 2, "stage": stage,
                                    "launchCount": launchCount, "policy": launchPolicy]
        guard let data = try? JSONSerialization.data(withJSONObject: record, options: [.sortedKeys]),
              data.count <= 32_768 else {
            XCTFail("Bounded launch-policy serialization failed")
            return false
        }
        var line = Data("P2_REQUESTED_LAUNCH_POLICY_V2:".utf8)
        line.append(data)
        line.append(Data("\n".utf8))
        // Write directly, avoiding Swift stdout buffering. Xcode forwarding is
        // separately evidenced by retained command output, never presumed.
        FileHandle.standardOutput.write(line)
        attachText(String(decoding: data, as: UTF8.self), name: "requested-launch-policy-" + stage)
        return true
    }

    private func capture(_ name: String) {
        guard app != nil else { return }
        let screenshot = XCTAttachment(screenshot: app.screenshot())
        screenshot.name = "host-probe-\(name).png"
        screenshot.lifetime = .keepAlways
        add(screenshot)
        let tree = app.debugDescription
        // The actual app snapshot is retained, bounded to 512 KiB. A truncated
        // snapshot cannot satisfy a successful observation receipt.
        let bytes = Array(tree.utf8.prefix(512 * 1024))
        attachText(String(decoding: bytes, as: UTF8.self), name: "host-probe-\(name).txt")
        XCTAssertLessThanOrEqual(tree.utf8.count, 512 * 1024, "AX evidence exceeds bound")
    }

    // These receipts describe failure-only evidence collection, never a retry or
    // an observation that can change the original probe status/stage. Each event
    // is written without Swift stdout buffering and attached independently before
    // advancing. Retained Xcode output, not this write alone, proves forwarding.
    private func publishFailureDiagnostic(_ captureStage: String, event: String,
                                          details: [String: Any] = [:]) throws {
        let record: [String: Any] = [
            "schemaVersion": 1, "identity": identity,
            "originalStatus": status, "originalStage": stage,
            "launchCount": launchCount, "launchCallEntered": launchCallEntered, "launchCallReturned": launchCallReturned,
            "sequence": failureDiagnosticSequence,
            "stage": captureStage, "event": event,
            "monotonicSeconds": ProcessInfo.processInfo.systemUptime,
            "details": details
        ]
        let data = try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys])
        var line = Data("P2_FAILED_LAUNCH_DIAGNOSTIC_V1:".utf8)
        line.append(data)
        line.append(Data("\n".utf8))
        FileHandle.standardOutput.write(line)
        let receipt = XCTAttachment(data: data, uniformTypeIdentifier: "public.json")
        receipt.name = "host-probe-failed-launch-diagnostic-\(failureDiagnosticSequence).json"
        receipt.lifetime = .keepAlways
        add(receipt)
        failureDiagnosticSequence += 1
    }

    private func applicationStateName(_ state: XCUIApplication.State) -> String {
        switch state {
        case .unknown: return "unknown"
        case .notRunning: return "notRunning"
        case .runningBackgroundSuspended: return "runningBackgroundSuspended"
        case .runningBackground: return "runningBackground"
        case .runningForeground: return "runningForeground"
        @unknown default: return "unrecognized"
        }
    }

    private func captureFailedLaunchDiagnostics() throws {
        guard status == "blocked", stage == "genuine-host-launch",
              launchCount == 1, launchCallEntered, !launchCallReturned, navigation.isEmpty, observations.isEmpty,
              app != nil else { return }
        try publishFailureDiagnostic("original-report", event: "complete",
                                     details: ["attachment": "host-probe-observations.json"])
        // Begin receipts survive an incomplete/failed public call. XCTest's
        // failures are neither intercepted nor suppressed; raw issues remain
        // separate from the unchanged original report. Public calls can stall:
        // the existing outer command deadline is the only hard execution bound.
        try publishFailureDiagnostic("state-before", event: "begin")
        let before = app.state
        try publishFailureDiagnostic("state-before", event: "complete", details: [
            "state": before.rawValue, "stateName": applicationStateName(before)
        ])
        let waitTimeout: TimeInterval = 10
        try publishFailureDiagnostic("foreground-wait", event: "begin", details: [
            "requestedState": "runningForeground", "timeoutSeconds": waitTimeout
        ])
        let waitStarted = ProcessInfo.processInfo.systemUptime
        let reachedForeground = app.wait(for: .runningForeground, timeout: waitTimeout)
        let waitFinished = ProcessInfo.processInfo.systemUptime
        let waitElapsed = waitFinished - waitStarted
        let withinBudget = waitElapsed >= 0 && waitElapsed <= waitTimeout
        try publishFailureDiagnostic("foreground-wait", event: "complete", details: [
            "requestedState": "runningForeground", "timeoutSeconds": waitTimeout,
            "returned": reachedForeground, "startedMonotonicSeconds": waitStarted,
            "finishedMonotonicSeconds": waitFinished, "elapsedSeconds": waitElapsed,
            "withinBudget": withinBudget
        ])
        try publishFailureDiagnostic("state-after", event: "begin")
        let after = app.state
        try publishFailureDiagnostic("state-after", event: "complete", details: [
            "state": after.rawValue, "stateName": applicationStateName(after)
        ])
        var skipReasons: [String] = []
        if !reachedForeground { skipReasons.append("wait-returned-false") }
        if !withinBudget { skipReasons.append("wait-budget-exceeded") }
        if after != .runningForeground { skipReasons.append("not-foreground") }
        guard skipReasons.isEmpty else {
            try publishFailureDiagnostic("finish", event: "skipped", details: [
                "outcome": "skipped", "reasons": skipReasons
            ])
            return
        }

        try publishFailureDiagnostic("screenshot", event: "begin",
                                     details: ["attachment": "host-probe-failure.png"])
        let screenshot = XCTAttachment(screenshot: app.screenshot())
        screenshot.name = "host-probe-failure.png"
        screenshot.lifetime = .keepAlways
        add(screenshot)
        try publishFailureDiagnostic("screenshot", event: "complete",
                                     details: ["attachment": "host-probe-failure.png"])

        let maximumBytes = 512 * 1024
        try publishFailureDiagnostic("accessibility", event: "begin", details: [
            "attachment": "host-probe-failure.txt", "maximumBytes": maximumBytes
        ])
        let tree = app.debugDescription
        let observedBytes = tree.utf8.count
        var retainedBytes = Data(tree.utf8.prefix(maximumBytes))
        // A UTF-8 code point may straddle the byte limit. Remove only that final
        // partial code point so decoding cannot expand the attached byte count.
        while String(data: retainedBytes, encoding: .utf8) == nil {
            retainedBytes.removeLast()
        }
        let snapshot = XCTAttachment(data: retainedBytes, uniformTypeIdentifier: "public.utf8-plain-text")
        snapshot.name = "host-probe-failure.txt"
        snapshot.lifetime = .keepAlways
        add(snapshot)
        try publishFailureDiagnostic("accessibility", event: "complete", details: [
            "attachment": "host-probe-failure.txt", "maximumBytes": maximumBytes,
            "observedUTF8Bytes": observedBytes, "retainedUTF8Bytes": retainedBytes.count,
            "truncated": observedBytes > retainedBytes.count
        ])
        try publishFailureDiagnostic("finish", event: "complete", details: ["outcome": "captured"])
    }

    override func tearDownWithError() throws {
        // Persist the original outcome before any extra XCUI call. Diagnostic
        // failure/timeout must not prevent this original report from being added.
        var report: [String: Any] = [
            "identity": identity, "status": status, "stage": stage,
            "launchCount": launchCount, "navigation": navigation,
            "observations": observations, "launchPolicy": launchPolicy
        ]
        if let serviceFailure { report["serviceFailure"] = serviceFailure }
        let data = try JSONSerialization.data(withJSONObject: report, options: [.sortedKeys])
        if status == "blocked", stage == "genuine-host-launch", launchCount == 1,
           launchCallEntered, !launchCallReturned, navigation.isEmpty, observations.isEmpty, app != nil {
            var line = Data("P2_HOST_PROBE_OBSERVATIONS_V1:".utf8)
            line.append(data)
            line.append(Data("\n".utf8))
            FileHandle.standardOutput.write(line)
        }
        let receipt = XCTAttachment(data: data, uniformTypeIdentifier: "public.json")
        receipt.name = "host-probe-observations.json"
        receipt.lifetime = .keepAlways
        add(receipt)
        try captureFailedLaunchDiagnostics()
        // Preserve the existing later-route failure snapshot, after the original
        // report. It is separate from the unreturned-launch diagnostic path.
        if status != "observed", launchCallReturned, launchCount == 1,
           app != nil, app.state == .runningForeground { capture("failure") }
        // No teardown termination/relaunch, preference clearing or device reset.
    }

    private func noUnexpectedAlerts() {
        XCTAssertEqual(app.alerts.count, 0, "Unexpected app/entitlement/authentication prompt blocks probe")
        let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
        XCTAssertEqual(springboard.alerts.count, 0, "OS permission/system prompt blocks probe")
    }

    private func cancelKnownNotificationExplanationIfPresent() {
        // Only the exact source-owned Later action may precede the separately
        // approved exact service-error acknowledgement. Neither requests permission.
        guard app.alerts.firstMatch.waitForExistence(timeout: 3) else { return }
        stage = "startup-prompt-inventory"
        XCTAssertEqual(app.alerts.count, 1)
        let alert = app.alerts.firstMatch
        let title = __NOTICE_TITLE__
        let body = __NOTICE_BODY__
        let later = __NOTICE_LATER__
        let allow = __NOTICE_ALLOW__
        capture("notice-before")
        let labels = alert.staticTexts.allElementsBoundByIndex.map(\.label)
        XCTAssertLessThanOrEqual(labels.count, 64)
        XCTAssertTrue(labels.allSatisfy { $0.utf8.count <= 16_384 })
        XCTAssertEqual(alert.label, title)
        XCTAssertEqual(labels.filter { Array($0.utf8) == Array(title.utf8) }.count, 1, "Unknown/ambiguous startup title")
        XCTAssertEqual(labels.filter { Array($0.utf8) == Array(body.utf8) }.count, 1, "Unknown/ambiguous startup message")
        let buttons = alert.buttons.allElementsBoundByIndex.map(\.label).sorted()
        XCTAssertEqual(buttons, [allow, later].sorted(), "Unexpected startup actions")
        let cancel = alert.buttons[later]
        let hittable = cancel.isHittable
        navigation.append(["action": "known-notification-later", "title": title,
                           "body": body, "actualStaticTextLabels": labels, "buttons": buttons, "tapped": later,
                           "hittableBeforeTap": hittable, "tapAttempted": false, "tapReturned": false,
                           "originalAlertAbsent": false, "successor": "not-observed"])
        XCTAssertTrue(hittable, "Known Later action is not hittable")
        stage = "ordinary-known-later-cancellation"
        navigation[0]["tapAttempted"] = true
        cancel.tap()
        navigation[0]["tapReturned"] = true
        // firstMatch can rebind to a distinct successor. Observe the exact
        // original title rather than demanding that every possible alert vanish.
        let original = app.alerts.matching(NSPredicate(format: "label == %@", title))
        let absent = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in original.count == 0 }, object: nil)
        let result = XCTWaiter.wait(for: [absent], timeout: 5)
        let originalAbsent = original.count == 0
        navigation[0]["originalAlertAbsent"] = originalAbsent
        XCTAssertEqual(result, .completed)
        XCTAssertTrue(originalAbsent)
        capture("notice-after")
        let remaining = app.alerts.count
        navigation[0]["successor"] = remaining == 0 ? "none" : "unclassified"
        if remaining != 0 {
            XCTAssertEqual(remaining, 1, "Multiple successor alerts block probe")
            acknowledgeExactServiceFailure()
        }
        noUnexpectedAlerts()
    }

    private func publishStartupReceipt(_ phase: String) {
        do {
            let receipt: [String: Any] = ["identity": identity, "phase": phase,
                "navigation": navigation, "serviceFailure": serviceFailure!]
            let data = try JSONSerialization.data(withJSONObject: receipt, options: [.sortedKeys])
            var line = Data("P2_STARTUP_ACKNOWLEDGEMENT_V1:".utf8)
            line.append(data)
            line.append(Data("\n".utf8))
            FileHandle.standardOutput.write(line)
        } catch {
            XCTFail("Unable to retain exact startup action receipt")
        }
    }

    private func acknowledgeExactServiceFailure() {
        // Pinned production OK only clears the displayed issue/error. This is
        // acknowledgement, never backend recovery, retry, authentication or copy.
        stage = "service-error-inventory"
        XCTAssertNil(serviceFailure, "Repeated service error blocks probe")
        XCTAssertEqual(navigation.count, 1)
        XCTAssertEqual(app.alerts.count, 1)
        let title = "SideStore"
        // Only these two fully specified source-owned messages are approved.
        // Bind the actual pair once; a later code change cannot inherit the tap.
        let approvedErrors: [(code: String, body: String)] = [
            ("SS-LAUNCH-C11-L12", "The embedded SideStore process could not be launched.\nError ID: SS-LAUNCH-C11-L12"),
            ("SS-LAUNCH-C11-L15", "The embedded SideStore process could not be launched.\nError ID: SS-LAUNCH-C11-L15")
        ]
        let matchingErrors = approvedErrors.filter { candidate in
            app.alerts.matching(NSPredicate(format: "label == %@", title))
                .containing(.staticText, identifier: candidate.body).count == 1
        }
        guard matchingErrors.count == 1 else {
            XCTFail("Unknown or ambiguous service error blocks probe")
            return
        }
        let diagnosticCode = matchingErrors[0].code
        let body = matchingErrors[0].body
        let exactAlerts = app.alerts.matching(NSPredicate(format: "label == %@", title)).containing(.staticText, identifier: body)
        XCTAssertEqual(exactAlerts.count, 1, "Exact service alert identity missing or ambiguous")
        let alert = exactAlerts.element(boundBy: 0)
        let labels = alert.staticTexts.allElementsBoundByIndex.map(\.label)
        XCTAssertLessThanOrEqual(labels.count, 64)
        XCTAssertTrue(labels.allSatisfy { $0.utf8.count <= 16_384 })
        XCTAssertEqual(alert.label, title)
        XCTAssertEqual(labels.filter { Array($0.utf8) == Array(title.utf8) }.count, 1)
        XCTAssertEqual(labels.filter { Array($0.utf8) == Array(body.utf8) }.count, 1, "Unknown service error blocks probe")
        XCTAssertEqual(labels.sorted(), [title, body].sorted(), "Extra service-error text blocks probe")
        let buttons = alert.buttons.allElementsBoundByIndex.map(\.label).sorted()
        XCTAssertEqual(buttons, ["Copy Diagnostics", "OK"], "Unknown service-error actions block probe")
        navigation[0]["successor"] = "exact-service-failure"
        serviceFailure = ["diagnosticCode": diagnosticCode, "title": title, "body": body,
                          "actualStaticTextLabels": labels, "buttons": buttons,
                          "presentationOnly": true, "resolved": false, "backendReadinessProven": false,
                          "hittableBeforeTap": false, "preTapInventoryVerified": false, "acknowledgementAttempted": false,
                          "acknowledgementReturned": false, "alertAbsentAfterAcknowledgement": false]
        publishStartupReceipt("identified")
        let ok = alert.buttons["OK"]
        XCTAssertEqual(alert.buttons.matching(NSPredicate(format: "label == %@", "OK")).count, 1)
        let hittable = ok.isHittable
        serviceFailure?["hittableBeforeTap"] = hittable
        navigation.append(["action": "known-service-error-ok", "title": title, "body": body,
                           "actualStaticTextLabels": labels, "buttons": buttons, "tapped": "OK",
                           "hittableBeforeTap": hittable, "preTapInventoryVerified": false, "tapAttempted": false, "tapReturned": false,
                           "allAlertsAbsentAfterTap": false])
        XCTAssertTrue(hittable, "Exact service-error OK is not hittable")
        XCTAssertEqual(XCUIApplication(bundleIdentifier: "com.apple.springboard").alerts.count, 0, "OS prompt blocks acknowledgement")
        stage = "ordinary-known-service-error-acknowledgement"
        // Re-evaluate the title/body-bound query and complete inventory directly
        // before the sole tap. A different live firstMatch can never inherit OK.
        XCTAssertEqual(app.alerts.count, 1)
        XCTAssertEqual(exactAlerts.count, 1)
        XCTAssertEqual(alert.label, title)
        XCTAssertEqual(alert.staticTexts.allElementsBoundByIndex.map(\.label).sorted(), [title, body].sorted())
        XCTAssertEqual(alert.buttons.allElementsBoundByIndex.map(\.label).sorted(), ["Copy Diagnostics", "OK"])
        XCTAssertEqual(alert.buttons.matching(NSPredicate(format: "label == %@", "OK")).count, 1)
        XCTAssertTrue(ok.isHittable)
        navigation[1]["preTapInventoryVerified"] = true
        serviceFailure?["preTapInventoryVerified"] = true
        navigation[1]["tapAttempted"] = true
        serviceFailure?["acknowledgementAttempted"] = true
        ok.tap()
        navigation[1]["tapReturned"] = true
        serviceFailure?["acknowledgementReturned"] = true
        let absent = XCTNSPredicateExpectation(predicate: NSPredicate { [weak self] _, _ in
            self?.app.alerts.count == 0
        }, object: nil)
        let result = XCTWaiter.wait(for: [absent], timeout: 5)
        let allAbsent = app.alerts.count == 0
        navigation[1]["allAlertsAbsentAfterTap"] = allAbsent
        serviceFailure?["alertAbsentAfterAcknowledgement"] = allAbsent
        XCTAssertEqual(result, .completed)
        XCTAssertTrue(allAbsent, "Repeated or unknown successor alert blocks probe")
        publishStartupReceipt("acknowledged")
        noUnexpectedAlerts()
        // serviceFailure deliberately remains unresolved in every later outcome.
    }

    private func picker() -> XCUIElement {
        let elements = app.descendants(matching: .any).matching(identifier: "settings.language")
        XCTAssertEqual(elements.count, 1, "Missing or ambiguous genuine Settings picker")
        let value = elements.element(boundBy: 0)
        XCTAssertTrue(value.isHittable, "Genuine Settings picker is not hittable")
        return value
    }

    private func selected(_ element: XCUIElement, is nativeName: String) -> Bool {
        if (element.value as? String) == nativeName { return true }
        if element.staticTexts.matching(NSPredicate(format: "label == %@", nativeName)).count == 1 { return true }
        let labelParts = element.label.components(separatedBy: ", ")
        return labelParts.contains(nativeName)
    }

    private func record(_ name: String, language: String, nativeName: String, settingsTitle: String) {
        stage = name
        noUnexpectedAlerts()
        let row = picker()
        let selectedValue = selected(row, is: nativeName)
        let settings = app.tabBars.buttons[settingsTitle]
        let visibleTab = settings.exists && settings.isHittable
        capture(name)
        observations.append([
            "stage": name, "language": language, "selectedNativeName": nativeName,
            "selectedValueVisible": selectedValue, "settingsTabVisible": visibleTab,
            "applicationForeground": app.state == .runningForeground,
            "pickerLabel": row.label, "pickerValue": row.value as? String ?? "",
            "pickerChildLabels": row.staticTexts.allElementsBoundByIndex.map(\.label),
            "settingsTabLabel": settings.label,
            "pickerFrame": ["x": row.frame.origin.x, "y": row.frame.origin.y,
                            "width": row.frame.size.width, "height": row.frame.size.height]
        ])
        XCTAssertTrue(selectedValue, "Selected language is not observable in the real picker row")
        XCTAssertTrue(visibleTab, "Actual Settings tab did not reflect selected catalog language")
        XCTAssertEqual(app.state, .runningForeground)
    }

    private func choose(_ nativeName: String) {
        stage = "open-genuine-language-picker"
        noUnexpectedAlerts()
        picker().tap()
        // Only a uniquely named, real hittable menu/navigation choice is used.
        // No accessibilityActivate, coordinate guesses or direct defaults writes.
        let choices = app.buttons.matching(NSPredicate(format: "label == %@", nativeName))
        XCTAssertTrue(choices.firstMatch.waitForExistence(timeout: 5))
        XCTAssertEqual(choices.count, 1, "Missing or ambiguous genuine language choice")
        XCTAssertTrue(choices.firstMatch.isHittable)
        choices.firstMatch.tap()
        let settled = XCTNSPredicateExpectation(predicate: NSPredicate { [weak self] _, _ in
            guard let self else { return false }
            let rows = self.app.descendants(matching: .any).matching(identifier: "settings.language")
            return rows.count == 1 && self.selected(rows.element(boundBy: 0), is: nativeName)
        }, object: nil)
        XCTAssertEqual(XCTWaiter.wait(for: [settled], timeout: 5), .completed)
    }

    func testUnchangedHostSettingsLanguageRoundTrip() {
        // Exact restored and freshly installed bytes were authenticated first.
        // Only requested target launch inputs are cleared. Xcode instrumentation
        // remains enabled; this does not claim an empty effective process environment.
        app = XCUIApplication(bundleIdentifier: identity["bundleIdentifier"]!)
        stage = "requested-target-launch-policy"
        let initialEnvironment = app.launchEnvironment
        let initialArguments = app.launchArguments
        let initialMatches = initialEnvironment == expectedInitialEnvironment
        let missingKeys = expectedInitialEnvironment.keys.filter { initialEnvironment[$0] == nil }.sorted()
        let mismatchedKeys = expectedInitialEnvironment.keys.filter {
            initialEnvironment[$0] != nil && initialEnvironment[$0] != expectedInitialEnvironment[$0]
        }.sorted()
        launchPolicy = ["status": "initial-observed", "expectedInitialEnvironment": expectedInitialEnvironment,
                        "generatedTargetEnvironment": generatedTargetEnvironment,
                        "initialEnvironmentMatched": initialMatches, "initialEnvironmentKeyCount": initialEnvironment.count,
                        "initialArgumentCount": initialArguments.count, "missingExpectedKeys": missingKeys,
                        "mismatchedExpectedKeys": mismatchedKeys,
                        "unknownKeyCount": initialEnvironment.keys.filter { expectedInitialEnvironment[$0] == nil }.count,
                        "performanceCheckerEnabled": true, "effectiveEnvironmentEmptyProven": false]
        // Unexpected values and arguments are never printed or attached.
        if initialMatches { launchPolicy["initialEnvironment"] = initialEnvironment }
        if initialArguments.isEmpty { launchPolicy["initialArguments"] = initialArguments }
        guard publishLaunchPolicy() else { return }
        guard initialEnvironment == expectedInitialEnvironment, initialArguments.isEmpty else {
            XCTFail("Unexpected actual initial launch inputs; no launch permitted")
            return
        }
        guard app.state == .notRunning else {
            XCTFail("Genuine app already running; no replacement launch permitted")
            return
        }
        app.launchEnvironment = [:]
        app.launchArguments = []
        let environmentCleared = app.launchEnvironment.isEmpty
        let argumentsCleared = app.launchArguments.isEmpty
        launchPolicy["requestedEnvironmentEmpty"] = environmentCleared
        launchPolicy["requestedArgumentsEmpty"] = argumentsCleared
        if environmentCleared { launchPolicy["requestedEnvironmentAfterClearing"] = app.launchEnvironment }
        if argumentsCleared { launchPolicy["requestedArgumentsAfterClearing"] = app.launchArguments }
        stage = "cleared-requested-target-launch-inputs"
        guard publishLaunchPolicy() else { return }
        guard app.launchEnvironment.isEmpty, app.launchArguments.isEmpty else {
            XCTFail("Requested launch inputs were not cleared; no launch permitted")
            return
        }
        launchPolicy["status"] = "cleared-before-single-launch"
        stage = "genuine-host-launch"
        launchCount += 1
        guard publishLaunchPolicy() else { return }
        launchCallEntered = true
        app.launch()
        launchCallReturned = true
        XCTAssertTrue(app.wait(for: .runningForeground, timeout: 20))
        capture("launch")
        cancelKnownNotificationExplanationIfPresent()
        noUnexpectedAlerts()
        stage = "ordinary-settings-tab-navigation"
        let settings = app.tabBars.buttons[__SETTINGS_EN__]
        XCTAssertTrue(settings.waitForExistence(timeout: 10), "Genuine Settings tab unreachable")
        XCTAssertTrue(settings.isHittable)
        settings.tap()
        record("en-before", language: "en", nativeName: "English", settingsTitle: __SETTINGS_EN__)
        choose("עברית")
        record("he-selected", language: "he", nativeName: "עברית", settingsTitle: __SETTINGS_HE__)
        choose("English")
        record("en-returned", language: "en", nativeName: "English", settingsTitle: __SETTINGS_EN__)
        status = "observed"
    }
}
