import XCTest
@MainActor final class FormDirectionTests: XCTestCase {
    private let app = XCUIApplication()
    private func state(_ language: String) throws {
        let element = app.staticTexts["direction-state"]
        let predicate = NSPredicate(format: "label == %@", language + "|Preserved user text 42|true")
        guard XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: predicate, object: element)], timeout: 8) == .completed else {
            let details = "State mismatch: label=\(element.label), value=\(String(describing:element.value)), input=\(String(describing:app.textFields["retained-input"].value)), toggle=\(String(describing:app.switches["retained-toggle"].value))"
            let boundedDetails = String(details.prefix(1000))
            print(boundedDetails)
            throw NSError(domain:"P2Direction",code:1,userInfo:[NSLocalizedDescriptionKey:boundedDetails])
        }
        XCTAssertEqual(app.textFields["retained-input"].value as? String, "Preserved user text 42")
        XCTAssertEqual(app.switches["retained-toggle"].value as? String, "1")
    }
    private func capture(_ name: String, language: String) throws {
        try state(language)
        let image = XCTAttachment(screenshot: app.screenshot())
        image.name = name + ".png"; image.lifetime = .keepAlways; add(image)
        try state(language) // Boundary check, not a claim of continuous/ABA-free stability.
        let receipt: [String:Any] = ["stage":name,"language":language,"state":app.staticTexts["direction-state"].label, "scope":"candidate-component-only"]
        let data = try JSONSerialization.data(withJSONObject: receipt, options:.sortedKeys)
        let attachment=XCTAttachment(data:data,uniformTypeIdentifier:"public.json")
        attachment.name=name + ".json"; attachment.lifetime = .keepAlways; add(attachment)
    }
    private func select(_ name: String) throws {
        let picker=app.descendants(matching:.any).matching(identifier:"settings.language").firstMatch
        guard picker.waitForExistence(timeout:8), picker.isHittable else { throw NSError(domain:"P2Direction",code:2) }
        picker.tap()
        let button=app.buttons.matching(NSPredicate(format:"label == %@",name)).firstMatch
        if button.waitForExistence(timeout:3), button.isHittable { button.tap(); return }
        let text=app.staticTexts.matching(NSPredicate(format:"label == %@",name)).firstMatch
        guard text.waitForExistence(timeout:3),text.isHittable else { throw NSError(domain:"P2Direction",code:3) }
        text.tap()
    }
    func testCandidateRoundTrip() throws {
        continueAfterFailure=false
        app.launch()
        let input=app.textFields["retained-input"]
        XCTAssertTrue(input.waitForExistence(timeout:8)); input.tap(); input.typeText("Preserved user text 42")
        let dismiss=app.buttons["dismiss-input"]
        XCTAssertTrue(dismiss.waitForExistence(timeout:3)); dismiss.tap()
        let matches=app.switches.matching(identifier:"retained-toggle")
        XCTAssertEqual(matches.count,1)
        let toggle=matches.element(boundBy:0)
        XCTAssertTrue(toggle.waitForExistence(timeout:3)); XCTAssertTrue(toggle.isHittable)
        XCTAssertEqual(toggle.value as? String, "0")
        let frame=toggle.frame
        XCTAssertTrue([frame.minX,frame.minY,frame.width,frame.height].allSatisfy { $0.isFinite })
        XCTAssertGreaterThan(frame.width,0); XCTAssertGreaterThan(frame.height,0)
        let inset=min(CGFloat(16),frame.width/4)
        let point=CGPoint(x:frame.maxX-inset,y:frame.midY)
        let window=app.frame
        XCTAssertTrue(window.contains(point))
        print("Initial toggle frame: \(frame), tap: \(point), window: \(window)")
        // English LTR Form may expose the whole row as the switch; hit its trailing control.
        toggle.coordinate(withNormalizedOffset: CGVector(dx:0,dy:0))
            .withOffset(CGVector(dx:frame.width-inset,dy:frame.height/2)).tap()
        let enabled = NSPredicate(format:"value == %@", "1")
        guard XCTWaiter.wait(for:[XCTNSPredicateExpectation(predicate:enabled,object:toggle)],timeout:5) == .completed else {
            let message = "Toggle setup failed: value=\(String(describing:toggle.value)), frame=\(toggle.frame)"
            print(message)
            throw NSError(domain:"P2Direction",code:4,userInfo:[NSLocalizedDescriptionKey:message])
        }
        try capture("candidate-en-initial",language:"en")
        try select("עברית")
        try capture("candidate-he",language:"he")
        try select("English")
        try capture("candidate-en-return",language:"en")
    }
}
