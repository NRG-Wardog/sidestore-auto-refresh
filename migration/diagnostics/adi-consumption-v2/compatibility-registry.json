{
  "contract_set": "runtime-adi-consumption-f9f23d9.v2",
  "contracts": {
    "adi-consumption-debug": {
      "description": "Temporary v2 bounded native ADI comparison, v1/v2 Swift decoding, wire and Copy Details contract, plus read-only per-key legacy comparison. Equality/coverage is observational and does not prove EOF, cryptographic binding, ADI acceptance or a fix.",
      "providers": [
        "AnisetteKit",
        "SideStore"
      ],
      "version": "2.0.0"
    },
    "anisette-provider": {
      "description": "Unchanged Anisette Swift/native API and identity/provider/VM/mutex/single-OTP behavior. This reviewed source basis tests staging the current unchanged ADI blob before normal setup; it does not enable recovery, reprovisioning, a second OTP or cleanup repair.",
      "providers": [
        "AnisetteKit"
      ],
      "version": "1.0.0"
    },
    "app-group-identity": {
      "description": "Shared App Group selection, fail-closed storage and cross-process handoff; duplicated runtime implementations remain frozen.",
      "providers": [
        "LiveContainer",
        "SideStore"
      ],
      "version": "1.0.0"
    },
    "auth-service-messages": {
      "description": "Versioned command envelope, auth sessions, prompt/secret handoff, cancellation and provisioning resume state.",
      "providers": [
        "LiveContainer",
        "SideStore"
      ],
      "version": "1.0.0"
    },
    "diagnostics": {
      "description": "Frozen finite error, trace and diagnostic producers/consumers; no claim that preserved logging or dormant paths are newly repaired.",
      "providers": [
        "AnisetteKit",
        "LiveContainer",
        "SideSign",
        "SideStore",
        "idevice",
        "jktcp",
        "minimuxer"
      ],
      "version": "1.0.0"
    },
    "idevice-ffi": {
      "description": "CoreDevice/AFC/tunnel C FFI exports, feature gates and lifecycle surface consumed by the Swift gateway.",
      "providers": [
        "idevice"
      ],
      "version": "1.0.0"
    },
    "jktcp-stream": {
      "description": "Adapter/handle TCP lifecycle, bounded zero-window persistence and error propagation consumed by idevice.",
      "providers": [
        "jktcp"
      ],
      "version": "1.0.0"
    },
    "refresh-results": {
      "description": "Refresh run correlation, result verification, persistent evidence and host/service refresh completion.",
      "providers": [
        "LiveContainer",
        "SideStore"
      ],
      "version": "1.0.0"
    },
    "sidesign-auth": {
      "description": "DeveloperPortal authentication, verification callback, auth models, anisette conversion and preserved account/provisioning error semantics.",
      "providers": [
        "SideSign"
      ],
      "version": "1.0.0"
    },
    "transport-capabilities": {
      "description": "Refresh transport selection, pairing/connection modes, backend capability and CoreDevice initialization/lease behavior.",
      "providers": [
        "minimuxer"
      ],
      "version": "1.0.0"
    },
    "xpc-service": {
      "description": "RefreshServer/RefreshClient selectors, primitive NSData command transport, launch/readiness and embedded service dispatch.",
      "providers": [
        "LiveContainer",
        "SideStore"
      ],
      "version": "1.0.0"
    }
  },
