        {
          "owner": "sidestore-auto-refresh",
          "path": "scripts/packaging_adapters.py",
          "interface": "IntegrationRule / apply_rules / COMBINED_PACKAGING_RULES",
          "rationale": "Keep custom replacement logic separate from the upstream shell."
